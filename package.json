{
  "name": "perfila",
  "private": true,
  "license": "MIT",
  "description": "Un solo estilo para todo tu perfil de GitHub: cabecera, estadísticas, racha, lenguajes, actividad, serpiente, versus y duelo.",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "dev:fixture": "node scripts/dev-server.js --fixture",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.js",
    "snapshots": "UPDATE_SNAPSHOTS=1 node --test tests/visual.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
