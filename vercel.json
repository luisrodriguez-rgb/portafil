{
  "rewrites": [
    {
      "source": "/u/:user",
      "destination": "/api/og?kind=page&slug=:user"
    },
    {
      "source": "/api/og/duel/:pair.png",
      "destination": "/api/og?kind=duel&slug=:pair&format=png"
    },
    {
      "source": "/api/og/duel/:pair.svg",
      "destination": "/api/og?kind=duel&slug=:pair&format=svg"
    },
    {
      "source": "/api/og/:user.png",
      "destination": "/api/og?kind=profile&slug=:user&format=png"
    },
    {
      "source": "/api/og/:user.svg",
      "destination": "/api/og?kind=profile&slug=:user&format=svg"
    },
    {
      "source": "/duel/:pair",
      "destination": "/api/duel?pair=:pair&format=page"
    },
    {
      "source": "/api/duel/:pair.svg",
      "destination": "/api/duel?pair=:pair&format=svg"
    },
    {
      "source": "/api/versus/:pair.svg",
      "destination": "/api/duel?pair=:pair&format=versus"
    },
    {
      "source": "/api/:kind(header|stats|streak|langs|activity|kit)/:user.svg",
      "destination": "/api/card?kind=:kind&user=:user"
    },
    {
      "source": "/api/calendar/:user.json",
      "destination": "/api/calendar?user=:user"
    },
    {
      "source": "/api/:user.svg",
      "destination": "/api/snake?user=:user"
    }
  ],
  "functions": {
    "api/snake.js": {
      "maxDuration": 10,
      "includeFiles": "{js,shared,action}/**"
    },
    "api/calendar.js": {
      "maxDuration": 10,
      "includeFiles": "{js,shared,action}/**"
    },
    "api/card.js": {
      "maxDuration": 10,
      "includeFiles": "{js,shared,action,server}/**"
    },
    "api/duel.js": {
      "maxDuration": 10,
      "includeFiles": "{js,shared,action,server}/**"
    },
    "api/og.js": {
      "maxDuration": 10,
      "includeFiles": "{js,shared,action,server,assets/fonts}/**"
    },
    "api/event.js": {
      "maxDuration": 5,
      "includeFiles": "{js,shared,action}/**"
    }
  }
}
